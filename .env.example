    { name: 'Content Creation', slug: 'content-creation', icon: '🎥' },
    { name: 'Electronics', slug: 'electronics', icon: '📱' },
    { name: 'Fashion', slug: 'fashion', icon: '👗' },
    { name: 'Shoes', slug: 'shoes', icon: '👟' },
    { name: 'Bags', slug: 'bags', icon: '👜' },
